# Copy to backend/.env for local work. Every value below is the local default, so the file
# is optional on a developer machine. Production (waheed.settings.prod) requires them all.
# DJANGO_SETTINGS_MODULE is read before this file, so set it in the shell or on Railway, not here.
# manage.py defaults to waheed.settings.dev; wsgi.py, asgi.py and the Celery app default to
# waheed.settings.prod so a deployment that forgets the variable fails at start-up.
SECRET_KEY=change-me
DATABASE_URL=postgres://localhost/waheed
REDIS_URL=redis://localhost:6379/0
TENANT_BASE_DOMAIN=localhost

# Production only
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# AI assistant (plan §6.1): Gemini's free tier is the default, OpenAI the fallback when set.
# Without any key the agent routes answer the Arabic "assistant is busy" message.
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_THROTTLE_RATE=20/minute

# Outbound messages: the Cloud API sender (logs for Restaurants without a connected number);
# messaging.senders.LoggingSender never sends anything.
MESSAGING_SENDER=messaging.whatsapp.WhatsAppSender

# WhatsApp Cloud API (ADR-0004). The verify token is any secret you choose and paste into Meta's
# webhook form; the app secret comes from the Meta app's settings; the template name is empty
# until Meta approves the fraud_alert utility template (alerts are logged until then).
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_FRAUD_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar

